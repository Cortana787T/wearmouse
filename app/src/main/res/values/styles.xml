<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Text" parent="@android:style/TextAppearance.DeviceDefault">
        <item name="android:textSize">@dimen/content_text_size</item>
        <item name="android:textColor">?android:textColorPrimary</item>
        <item name="android:fontFamily">sans-serif-condensed-light</item>
    </style>

    <style name="Text.Dialog">
        <item name="android:gravity">center</item>
        <item name="android:layout_gravity">center_horizontal</item>
    </style>

    <style name="Text.Dialog.Title">
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@android:color/black</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_screen</item>
        <item name="postSplashScreenTheme">@android:style/Theme.DeviceDefault</item>
    </style>

    <!-- Disable Wear OS edge swipe while using the input screen -->
    <style name="Theme.WearMouse.Input" parent="@style/Theme.Wearable.Modal">
        <item name="android:windowSwipeToDismiss">false</item>
    </style>

</resources>
